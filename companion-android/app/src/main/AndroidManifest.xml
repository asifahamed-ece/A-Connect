<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only used while the pairing screen is open, to scan the computer's QR. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        The shipping app.

        It deliberately registers NO accessibility service: Android blocks
        contactless payments while any accessibility service is enabled, and a
        payments app that breaks the user's phone is not worth a seamless
        clipboard. The privileged clipboard access comes from the default
        keyboard role instead, which the platform grants to the default IME
        only - see the companion-android guard test that keeps it that way.
    -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.APlusConnectCompanion">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The clipboard keyboard: holding this role is what gives the app
             privileged clipboard access without an accessibility service. -->
        <service
            android:name=".ui.ime.AplusImeService"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- A transparent window that takes focus so the clipboard can be read
             by the notification action. -->
        <activity
            android:name=".clip.ClipboardReadActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.APlusTransparent" />

        <service
            android:name=".service.CompanionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
