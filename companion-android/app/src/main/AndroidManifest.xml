<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Signature-level: only an app signed with this app's key can send it,
         which in practice means the A+ Connect keyboard. -->
    <permission
        android:name="com.aplusconnect.companion.permission.CLIPBOARD_BRIDGE"
        android:label="Send the phone clipboard to A+ Connect"
        android:protectionLevel="signature" />
    <!-- Only used while the pairing screen is open, to scan the computer's QR. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        Reading the phone's files for the computer.

        The folder picker cannot do this job: since Android 11 it refuses the
        storage root, the SD card root and the Download directory, which are
        most of what a user wants to reach. All files access is the special
        permission Android provides for a file browser, granted once from
        Settings. It is not an accessibility service, so contactless payments
        keep working.

        The browser is read-only by construction (PhoneFileBrowserTest fails
        the build if it ever calls a write API).
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Only for Android 10 and older, which predate all files access. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
        The shipping app.

        It deliberately registers NO accessibility service: Android blocks
        contactless payments while any accessibility service is enabled, and a
        payments app that breaks the user's phone is not worth a seamless
        clipboard. The privileged clipboard access comes from the default
        keyboard role instead, which the platform grants to the default IME
        only - see the companion-android guard test that keeps it that way.
    -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.APlusConnectCompanion">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The patched keyboard broadcasts what was copied; this app is the
             only listener, and only a same-signed app may send it. -->
        <receiver
            android:name=".clip.ClipboardBridgeReceiver"
            android:exported="true"
            android:permission="com.aplusconnect.companion.permission.CLIPBOARD_BRIDGE">
            <intent-filter>
                <action android:name="com.aplusconnect.companion.action.CLIPBOARD" />
            </intent-filter>
        </receiver>

        <!-- A transparent window that takes focus so the clipboard can be read
             by the notification action. -->
        <activity
            android:name=".clip.ClipboardReadActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.APlusTransparent" />

        <service
            android:name=".service.CompanionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Optional, and never an accessibility service: it only runs once the
             user grants notification access in Settings, and the rest of the
             app works without it. -->
        <service
            android:name=".service.PhoneNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
